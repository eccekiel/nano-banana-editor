# Sol Image Hub / MCP OAuth
# Real secrets belong in Vercel, never in Git.
# BETTER_AUTH_URL and MCP_RESOURCE_URL are optional on Vercel:
# the app derives the URL from Vercel system variables.

# Required for Better Auth OAuth/session persistence.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
BETTER_AUTH_SECRET=replace_with_a_random_32_plus_character_secret

# Required for image editing.
REPLICATE_API_TOKEN=your_replicate_token_here
MCP_EDIT_ENABLED=true

# Optional overrides for a custom domain or non-Vercel deployment.
# BETTER_AUTH_URL=https://YOUR-HUB-DOMAIN.example
# MCP_RESOURCE_URL=https://YOUR-HUB-DOMAIN.example/api/mcp

# Legacy app variable kept for compatibility with older builds.
GOOGLE_GENERATIVE_AI_API_KEY=your_api_key_here
