# Sol Image Hub / MCP OAuth
# Set these in Vercel; never commit real secrets.
# BETTER_AUTH_URL is the app origin (NOT /api/auth).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
BETTER_AUTH_SECRET=replace_with_a_random_32_plus_character_secret
BETTER_AUTH_URL=https://YOUR-HUB-DOMAIN.vercel.app
MCP_RESOURCE_URL=https://YOUR-HUB-DOMAIN.vercel.app/api/mcp
MCP_EDIT_ENABLED=true
REPLICATE_API_TOKEN=your_replicate_token_here

# Legacy app variable kept for compatibility with older builds.
GOOGLE_GENERATIVE_AI_API_KEY=your_api_key_here
